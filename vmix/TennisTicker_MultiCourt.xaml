        <Border Grid.Row="1" Grid.Column="4" Background="#2EFFFFFF" CornerRadius="8" Margin="5,14,5,14">
          <TextBlock x:Name="court1_p1_set3" Text="" FontFamily="Arial" FontSize="34" FontWeight="Bold"
                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border Grid.Row="1" Grid.Column="5" Background="#FFD9A441" CornerRadius="8" Margin="5,14,0,14">
          <TextBlock x:Name="court1_p1_points" Text="" FontFamily="Arial" FontSize="34" FontWeight="Bold"
                     Foreground="#FF0A0A12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <TextBlock x:Name="court1_p2_serve" Grid.Row="2" Grid.Column="0"
