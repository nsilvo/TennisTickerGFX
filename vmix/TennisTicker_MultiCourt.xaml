    <!-- Tournament header -->
    <Border Canvas.Left="510" Canvas.Top="60" Width="900" Height="80"
            CornerRadius="14" BorderBrush="#40FFFFFF" BorderThickness="2" Background="#F50A0A12">
      <TextBlock x:Name="tournament" Text="TOURNAMENT" FontFamily="Arial" FontSize="36"
                 FontWeight="Bold" Foreground="White"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>

