        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="44"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="78"/>
          <ColumnDefinition Width="78"/>
          <ColumnDefinition Width="78"/>
          <ColumnDefinition Width="106"/>
