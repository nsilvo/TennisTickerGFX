        <TextBlock x:Name="court1_court" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="COURT 1" FontFamily="Arial" FontSize="30" FontWeight="Bold"
                   Foreground="#FFD9A441" VerticalAlignment="Center"/>
        <TextBlock x:Name="court1_status" Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3"
                   Text="LIVE" FontFamily="Arial" FontSize="22" FontWeight="Bold"
                   Foreground="#B4FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>

        <TextBlock x:Name="court1_p1_serve" Grid.Row="1" Grid.Column="0"
                   Text="●" FontFamily="Arial" FontSize="30" Foreground="#FFFFD34D"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock x:Name="court1_p1_name" Grid.Row="1" Grid.Column="1"
                   Text="PLAYER ONE" FontFamily="Arial" FontSize="34" FontWeight="Bold"
                   Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"
                   TextTrimming="CharacterEllipsis"/>
        <Border Grid.Row="1" Grid.Column="2" Background="#2EFFFFFF" CornerRadius="8" Margin="5,14,5,14">
          <TextBlock x:Name="court1_p1_set1" Text="" FontFamily="Arial" FontSize="34" FontWeight="Bold"
                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border Grid.Row="1" Grid.Column="3" Background="#2EFFFFFF" CornerRadius="8" Margin="5,14,5,14">
          <TextBlock x:Name="court1_p1_set2" Text="" FontFamily="Arial" FontSize="34" FontWeight="Bold"
