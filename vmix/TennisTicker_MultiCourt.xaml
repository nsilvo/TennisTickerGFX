          <GradientStop Color="#F50F0F1E" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid Margin="26,16,26,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="66"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
